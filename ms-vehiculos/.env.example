# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.
# ms-usuarios usa el 3005; los microservicios de los estudiantes, del 3002 en adelante.
# Configuración del microservicio ms-vehiculos
PORT=3005
HOST=127.0.0.1

# Conexión a la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=logired_vehiculos
JWT_SECRET=replace_with_shared_jwt_secret