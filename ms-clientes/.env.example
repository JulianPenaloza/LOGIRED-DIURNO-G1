# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.
# ms-clientes usa el 3002; los microservicios de los estudiantes, del 3002 en adelante.
PORT=3002
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=clientes_db
DB_USER=clientes_user
# Clave del usuario de MySQL de cada integrante (escríbala en su .env, no aquí)
DB_PASSWORD=una-clave-segura

# Debe ser la misma frase en todos los microservicios del grupo y en ms-usuarios
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta