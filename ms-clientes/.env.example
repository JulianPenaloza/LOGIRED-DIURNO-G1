# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# Puerto donde escucha este microservicio.
# ms-clientes usa el 3002; los microservicios de los estudiantes, del 3002 en adelante.
PORT=3002
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estara en ese mismo equipo)
HOST=127.0.0.1

# En su PC: localhost. En servidor2: la IP de servidor1 (172.24.0.134)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clientes_db
DB_USER=clientes_user
# Clave del usuario de MySQL de cada integrante (escribala en su .env, no aqui)
DB_PASSWORD=ESCRIBA-SU-CLAVE

# Debe ser la misma frase en todos los microservicios del grupo y en ms-usuarios
JWT_SECRET=ESCRIBA-EL-SECRETO-DEL-GRUPO
